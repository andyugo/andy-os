{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github/workflows/build\\.yml$"],
      "matchStrings": [
        "FEDORA_VERSION:\\s*\"(?<currentValue>\\d+)\""
      ],
      "depNameTemplate": "quay.io/fedora/fedora-bootc",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/fedora/fedora-bootc"],
      "automerge": false,
      "labels": ["fedora-upgrade"]
    }
  ]
}
